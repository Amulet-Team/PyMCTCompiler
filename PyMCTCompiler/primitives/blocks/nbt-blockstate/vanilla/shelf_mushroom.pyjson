{
    "to_universal": [
        {
            "function": "new_block",
            "options": "universal_minecraft:shelf_mushroom"
        },
        {
            "function": "map_properties",
            "options": {
                "minecraft:cardinal_direction": {
                    direction: [
                        {
                            "function": "new_properties",
                            "options": {
                                "facing": facing
                            }
                        }
                    ] for direction, facing in {
                        "\"east\"": "\"east\"",
                        "\"south\"": "\"south\"",
                        "\"west\"": "\"west\"",
                        "\"north\"": "\"north\"",
                    }.items()
                },
                "growth": {
                    growth: [
                        {
                            "function": "new_properties",
                            "options": {
                                "age": age
                            }
                        }
                    ] for growth, age in {
                        "0": "\"0\"",
                        "1": "\"1\""
                    }.items()
                }
            }
        }
    ],
    "from_universal": {
        "universal_minecraft:shelf_mushroom": [
            {
                "function": "new_block",
                "options": "minecraft:shelf_mushroom"
            },
            {
                "function": "map_properties",
                "options": {
                    "facing": {
                        facing: [
                            {
                                "function": "new_properties",
                                "options": {
                                    "minecraft:cardinal_direction": direction
                                }
                            }
                        ] for direction, facing in {
                            "\"east\"": "\"east\"",
                            "\"south\"": "\"south\"",
                            "\"west\"": "\"west\"",
                            "\"north\"": "\"north\"",
                        }.items()
                    },
                    "age": {
                        age: [
                            {
                                "function": "new_properties",
                                "options": {
                                    "growth": growth
                                }
                            }
                        ] for growth, age in {
                            "0": "\"0\"",
                            "1": "\"1\""
                        }.items()
                    }
                }
            }
        ]
    }
}